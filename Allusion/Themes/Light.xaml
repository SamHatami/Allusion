<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Theme colors  -->
    <Color x:Key="Transparent" A="0" B="0" G="0" R="0" />
    <Color x:Key="Primary.Gray" A="255" B="128" G="128" R="128" />
    <Color x:Key="Primary.Red" A="255" B="70" G="70" R="95" />
    <Color x:Key="Primary.Green" A="255" B="90" G="95" R="90" />
    <Color x:Key="Secondary.Green" A="255" B="105" G="110" R="105" />
    <Color x:Key="Primary.Selected" A="255" B="130" G="130" R="130" />
    <Color x:Key="Primary.Unselected" A="255" B="125" G="125" R="125" />
    <Color x:Key="Primary.Background" A="255" B="120" G="120" R="120" />
    <Color x:Key="Secondary.Background" A="255" B="130" G="130" R="130" />
    <Color x:Key="Primary.Button" A="255" B="135" G="145" R="135" />
    <Color x:Key="Secondary.Button" A="255" B="120" G="120" R="120" />
    <Color x:Key="Primary.TextBox.Background" A="255" B="155" G="155" R="155" />
    <Color x:Key="Primary.Foreground" A="255" B="10" G="10" R="10" />
    <Color x:Key="Secondary.Foreground" A="255" B="35" G="35" R="35" />
    <Color x:Key="Primary.Border" A="255" B="140" G="140" R="140" />
    <Color x:Key="Secondary.Border" A="255" B="145" G="150" R="145" />
    <Color x:Key="Image.Border" A="255" B="85" G="85" R="85" />
    <Color x:Key="Primary.Border.UnSelected" A="255" B="125" G="125" R="125" />
    <Color x:Key="Logo" A="255" B="70" G="73" R="70" />
    <Color x:Key="Logo.Border" A="255" B="245" G="255" R="245" />

    <!--  Theme brushes (literal: every theme fully describes the palette)  -->
    <SolidColorBrush x:Key="Transparent.Brush" Color="#00000000" />
    <SolidColorBrush x:Key="Window.TitleBar.Color" Color="#FF787878" />
    <SolidColorBrush x:Key="Window.TitleBar.ForeGround" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="Window.Titlebar.Button.MouseOver" Color="#FFD3D3D3" />
    <SolidColorBrush x:Key="Window.Titlebar.Button.Close" Color="#FF5F4646" />
    <SolidColorBrush x:Key="Mouse.OnClick" Color="#FF696969" />
    <SolidColorBrush x:Key="Allusion.Logo" Color="#FF464946" />
    <SolidColorBrush x:Key="Allusion.Logo.Border" Color="#FFF5FFF5" />
    <SolidColorBrush x:Key="BackGround" Color="#FF787878" />
    <SolidColorBrush x:Key="Mouse.IsOver" Color="#FF5A5F5A" />
    <SolidColorBrush x:Key="Board.Background" Color="#FF787878" />
    <SolidColorBrush x:Key="Label.Title.Background" Color="#FF787878" />
    <SolidColorBrush x:Key="Foreground" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="Foreground.Front" Color="#FF232323" />
    <SolidColorBrush x:Key="Border" Color="#FF8C8C8C" />
    <SolidColorBrush x:Key="Window.Close" Color="#FF5F4646" />
    <SolidColorBrush x:Key="Dialog.BackGround" Color="#FF828282" />
    <SolidColorBrush x:Key="Dialog.Border" Color="#FF919691" />
    <SolidColorBrush x:Key="Dialog.TextBox.Background" Color="#FF9B9B9B" />
    <SolidColorBrush x:Key="Info.BackGround" Color="#FF828282" />
    <SolidColorBrush x:Key="ImageItem.Border" Color="#FF555555" />
    <SolidColorBrush x:Key="ImageItem.TextBlock.Background" Color="#FF555555" />
    <SolidColorBrush x:Key="ListBox.Background" Color="#FF828282" />
    <SolidColorBrush x:Key="ListBox.Item.Foreground" Color="#FF232323" />
    <SolidColorBrush x:Key="ListBox.Item.Selected" Color="#FF696E69" />
    <SolidColorBrush x:Key="ListBox.Item.UnSelected" Color="#FF7D7D7D" />
    <SolidColorBrush x:Key="TextBox.Border.Focus" Color="#FF696E69" />
    <SolidColorBrush x:Key="TextBox.Foreground" Color="#FF232323" />
    <SolidColorBrush x:Key="TextBox.Border" Color="#FF919691" />
    <SolidColorBrush x:Key="TextBox.Background.Focus" Color="#FF828282" />
    <SolidColorBrush x:Key="TextBox.Background" Color="#FF9B9B9B" />
    <SolidColorBrush x:Key="Tab.Button.Border.Selected" Color="#FF8C8C8C" />
    <SolidColorBrush x:Key="Tab.Button.Selected" Color="#FF828282" />
    <SolidColorBrush x:Key="Tab.Button.UnSelected" Color="#FF7D7D7D" />
    <SolidColorBrush x:Key="Tab.Button.Border.UnSelected" Color="#FF7D7D7D" />
    <SolidColorBrush x:Key="Button.Primary.Background" Color="#FF879187" />
    <SolidColorBrush x:Key="Button.Primary.Border" Color="#FF696E69" />
    <SolidColorBrush x:Key="Button.Primary.MouseOver" Color="#FF5A5F5A" />
    <SolidColorBrush x:Key="Button.Secondary.Background" Color="#FF787878" />
    <SolidColorBrush x:Key="Button.Secondary.Border" Color="#FF919691" />
    <SolidColorBrush x:Key="Button.Secondary.Selected" Color="#FF696E69" />

</ResourceDictionary>
