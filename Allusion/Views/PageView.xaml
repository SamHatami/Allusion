<UserControl
    x:Class="Allusion.Views.PageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:behaviors="clr-namespace:Allusion.Behaviors"
    xmlns:cm="http://caliburnmicro.com"
    xmlns:controls="clr-namespace:Allusion.WPFCore.Controls;assembly=Allusion.WPFCore"
    xmlns:converter="clr-namespace:Allusion.WPFCore.Converter;assembly=Allusion.WPFCore"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:Allusion.ViewModels"
    cm:Message.Attach="[Gesture Ctrl+Z] = [UndoRemove]; [Gesture Ctrl+Shift+F] = [BringToFront]; [Gesture Ctrl+Shift+B] = [SendToBack];"
    d:DataContext="{d:DesignInstance Type=viewModels:PageViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    SnapsToDevicePixels="True"
    mc:Ignorable="d">


    <UserControl.Resources>

        <converter:StringToVisibilityConverter x:Key="StringToVis" />
        <converter:InvertBoolToVis x:Key="InvertBoolVis" />
        <converter:InverseZoomDoubleConverter x:Key="InverseZoomDouble" />
        <DrawingBrush
            x:Key="SnapGridBrush"
            TileMode="Tile"
            Viewport="0,0,25,25"
            ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="25,0" />
                            <LineGeometry StartPoint="0,0" EndPoint="0,25" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource Foreground}" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="TriangleThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="{Binding DataContext.Viewport.Zoom, RelativeSource={RelativeSource AncestorType=Canvas}, Converter={StaticResource InverseZoomDouble}, ConverterParameter=15}" />
            <Setter Property="Height" Value="{Binding DataContext.Viewport.Zoom, RelativeSource={RelativeSource AncestorType=Canvas}, Converter={StaticResource InverseZoomDouble}, ConverterParameter=15}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Viewbox Stretch="Fill">
                            <Polygon
                                x:Name="TriangleThumb"
                                Fill="{DynamicResource Tab.Button.Selected}"
                                Points="15,-5 -5,15 15,15"
                                StrokeThickness="0" />
                        </Viewbox>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TriangleThumb" Property="Fill" Value="{DynamicResource Foreground.Front}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>


    <Grid
        Background="Transparent"
        ClipToBounds="True"
        Focusable="True">
        <Grid.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem
                    cm:Message.Attach="[PasteOnCanvas]"
                    Header="Paste"
                    IsEnabled="True" />
                <MenuItem Header="Arrange">
                    <MenuItem Header="Presets" IsEnabled="False" />
                    <Separator />
                    <MenuItem cm:Message.Attach="[ArrangeKeepCurrent]" Header="Keep current size" />
                    <MenuItem cm:Message.Attach="[ArrangeAverageHeight]" Header="Normalize average height" />
                    <MenuItem cm:Message.Attach="[ArrangeSmallestHeight]" Header="Normalize smallest height" />
                    <Separator />
                    <MenuItem cm:Message.Attach="[ArrangeSettings]" Header="Settings" />
                </MenuItem>
                <MenuItem Header="Order">
                    <MenuItem cm:Message.Attach="[BringToFront]" Header="Bring to front" />
                    <MenuItem cm:Message.Attach="[BringForward]" Header="Bring forward" />
                    <MenuItem cm:Message.Attach="[SendBackward]" Header="Send backward" />
                    <MenuItem cm:Message.Attach="[SendToBack]" Header="Send to back" />
                </MenuItem>
                <MenuItem Header="Align">
                    <MenuItem cm:Message.Attach="[AlignLeft]" Header="Left" />
                    <MenuItem cm:Message.Attach="[AlignHorizontalCenters]" Header="Horizontal centers" />
                    <MenuItem cm:Message.Attach="[AlignRight]" Header="Right" />
                    <Separator />
                    <MenuItem cm:Message.Attach="[AlignTop]" Header="Top" />
                    <MenuItem cm:Message.Attach="[AlignVerticalCenters]" Header="Vertical centers" />
                    <MenuItem cm:Message.Attach="[AlignBottom]" Header="Bottom" />
                </MenuItem>
                <MenuItem cm:Message.Attach="[Save]" Header="Save" />
            </ContextMenu>
        </Grid.ContextMenu>
        <b:Interaction.Behaviors>
            <behaviors:CanvasViewportBehavior />
        </b:Interaction.Behaviors>
        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" />
        <Canvas
            x:Name="ImageCanvas"
            Width="20000"
            Height="20000"
            AllowDrop="True"
            Background="Transparent"
            Focusable="True">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="{Binding Viewport.Zoom}" ScaleY="{Binding Viewport.Zoom}" />
                    <TranslateTransform X="{Binding Viewport.OffsetX}" Y="{Binding Viewport.OffsetY}" />
                </TransformGroup>
            </Canvas.RenderTransform>
            <b:Interaction.Behaviors>
                <behaviors:CanvasBehavior />
                <behaviors:CanvasSelectionBoxBehavior />
            </b:Interaction.Behaviors>
            <Rectangle
                Width="20000"
                Height="20000"
                Fill="{StaticResource SnapGridBrush}"
                IsHitTestVisible="False"
                Opacity="0.35"
                Visibility="{Binding ShowSnapGrid, Converter={StaticResource BoolToVis}}" />
            <ItemsControl ItemsSource="{Binding Images}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="ImageGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid
                                Name="ImageContent"
                                Grid.Row="0" 
                                Width="{Binding Width, Mode=OneWay}"
                                Height="{Binding Height, Mode=OneWay}" UseLayoutRounding="False">
                                <ContentControl
                                    cm:View.Model="{Binding}"
                                    IsHitTestVisible="True"              
                >
                                    <ContentControl.ContextMenu>
                                        <ContextMenu
                                            x:Name="ImageContextMenu"
                                            DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem cm:Message.Attach="AddNote" Header="Add note" />
                                            <MenuItem cm:Message.Attach="RemoveNote" Header="Remove Note" />
                                            <!--<MenuItem
                                                DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                DisplayMemberPath="DisplayName"
                                                Header="Move to..."
                                                ItemsSource="{Binding Board.Pages}">
                                                <MenuItem.ItemContainerStyle>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="cm:Message.Attach" Value="[Event Click] = [MoveImage($dataContext)]" />
                                                    </Style>
                                                </MenuItem.ItemContainerStyle>
                                            </MenuItem>-->
                                            <MenuItem Header="Size">
                                                <MenuItem cm:Message.Attach="SetSize('0.25')" Header="25%" />
                                                <MenuItem cm:Message.Attach="SetSize('0.50')" Header="50%" />
                                                <MenuItem cm:Message.Attach="SetSize('0.75')" Header="75%" />
                                                <MenuItem cm:Message.Attach="SetSize('1.00')" Header="100%" />
                                                <MenuItem cm:Message.Attach="SetSize('1.25')" Header="125%" />
                                                <MenuItem cm:Message.Attach="SetSize('1.50')" Header="150%" />
                                                <MenuItem cm:Message.Attach="SetSize('1.75')" Header="175%" />
                                                <MenuItem cm:Message.Attach="SetSize('2.00')" Header="200%" />
                                                <MenuItem cm:Message.Attach="SetSize('2.25')" Header="225%" />
                                                <MenuItem cm:Message.Attach="SetSize('2.50')" Header="250%" />
                                            </MenuItem>
                                        </ContextMenu>
                                    </ContentControl.ContextMenu>
                                </ContentControl>
                                <Thumb
                                    x:Name="ResizeThumb"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource ImageItem.Border}"
                                    DragCompleted="ResizeThumb_OnDragCompleted"
                                    DragDelta="OnResizeThumbDragDelta"
                                    DragStarted="ResizeThumb_OnDragStarted"
                                    Style="{DynamicResource TriangleThumbStyle}" />
                                <fa:IconImage
                                    x:Name="DragIcon"
                                    Height="22"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Foreground="{DynamicResource Foreground.Front}"
                                    Icon="BorderTopLeft"
                                    Visibility="Hidden" />
                            </Grid>
                            <Border
                                Grid.Row="1"
                                BorderBrush="{DynamicResource ImageItem.Border}"
                                Visibility="{Binding Description, Converter={StaticResource StringToVis}}">
                                <Grid x:Name="DescriptionGrid">
                                    <TextBlock
                                        x:Name="PageLabel"
                                        Width="{Binding ActualWidth, ElementName=ImageContent}"
                                        Style="{DynamicResource DescriptionTextBlock}"
                                        Text="{Binding Description}"
                                        TextWrapping="Wrap">
                                        <b:Interaction.Behaviors>
                                            <behaviors:RenameBehavior IsSingleClick="True" TextBox="{Binding ElementName=RenameTextBox}" />
                                        </b:Interaction.Behaviors>
                                    </TextBlock>
                                    <TextBox
                                        x:Name="RenameTextBox"
                                        Width="{Binding ActualWidth, ElementName=ImageContent}"
                                        AcceptsReturn="True"
                                        GotFocus="UIElement_OnGotFocus"
                                        KeyDown="OnRenameKeyDown"
                                        LostFocus="OnRenameLostFocus"
                                        Style="{DynamicResource RenamePageName}"
                                        Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <b:Interaction.Behaviors>
                                <behaviors:ImageBehavior />
                            </b:Interaction.Behaviors>
                        </Grid>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemContainerStyle>
                    <Style>
                        <Setter Property="Canvas.Left" Value="{Binding PosX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Setter Property="Canvas.Top" Value="{Binding PosY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Setter Property="Panel.ZIndex" Value="{Binding ZIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>

            <Rectangle
                x:Name="SelectionRectangle"
                Fill="{DynamicResource Foreground}"
                Opacity="0.25"
                Stroke="{DynamicResource Mouse.IsOver}"
                StrokeThickness="1" />
        </Canvas>

        <Border Visibility="{Binding ShowHelpBox, Converter={StaticResource BoolToVis}}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <StackPanel />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Bottom"
                    Foreground="{DynamicResource Foreground.Front}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"><Run Language="sv-se" Text="Drop images anywhere on the canvas" /><LineBreak /><Run Language="sv-se" Text="Or simply paste with Ctrl-V" /></TextBlock>

                <fa:IconImage
                    Grid.Row="1"
                    Height="30"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Foreground}"
                    Icon="FileArrowDown" />

            </Grid>
        </Border>


        <!--  INFO NOTE  -->


    </Grid>

</UserControl>
