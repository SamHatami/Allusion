<Window
    x:Class="Allusion.Views.Dialogs.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cm="http://caliburnmicro.com"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:Allusion.ViewModels.Dialogs"
    xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Settings"
    MinWidth="400"
    SizeToContent="WidthAndHeight"
    cm:Message.Attach="[Key Escape] = [Close]; [Key Enter] = [Close]"
    d:DataContext="{d:DesignInstance Type=dialogs:SettingsViewModel}"
    ResizeMode="NoResize"
    Style="{DynamicResource DialogWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />
    </WindowChrome.WindowChrome>

    <Grid Style="{DynamicResource DialogContentGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="{Binding Title}"
                Style="{DynamicResource DialogTitleLabel}" />
            <Button
                x:Name="CloseButton"
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                cm:Message.Attach="[Close]"
                Style="{DynamicResource TitleBarButtonClose}">
                <fa:IconImage Height="12" Icon="Close" />
            </Button>
        </Grid>

        <Label
            Grid.Row="1"
            Content="Theme"
            Style="{DynamicResource DialogSectionHeader}" />
        <ComboBox
            Grid.Row="2"
            ItemsSource="{Binding Themes}"
            SelectedItem="{Binding SelectedTheme}"
            Style="{DynamicResource DialogComboBox}" />

        <CheckBox
            Grid.Row="3"
            Margin="0,10,0,0"
            Content="Always on top"
            IsChecked="{Binding TopMost}"
            Style="{DynamicResource DialogCheckBox}" />

        <Label
            Grid.Row="4"
            Content="Image border thickness"
            Style="{DynamicResource DialogSectionHeader}" />
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Slider
                VerticalAlignment="Center"
                Maximum="12"
                Minimum="0"
                Value="{Binding ImageBorderThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                Grid.Column="1"
                Width="30"
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource Foreground}"
                Text="{Binding ImageBorderThickness, StringFormat={}{0:0.0}}" />
        </Grid>

        <StackPanel
            Grid.Row="6"
            Margin="0,10,0,0"
            Orientation="Horizontal">
            <Label
                Padding="0"
                Content="Version"
                Style="{DynamicResource DialogSectionHeader}" />
            <TextBlock
                Margin="6,0,0,0"
                VerticalAlignment="Bottom"
                FontSize="12"
                Foreground="{DynamicResource Foreground}"
                Text="{Binding CurrentVersion}" />
        </StackPanel>
        <TextBlock
            Grid.Row="7"
            Foreground="{DynamicResource Foreground}"
            Text="{Binding UpdateStatus}"
            TextWrapping="Wrap" />
        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="CheckNow"
                Content="Check now"
                Style="{DynamicResource DialogSecondaryButton}" />
            <Button
                x:Name="OpenDownload"
                Grid.Column="1"
                Margin="5,0,0,0"
                Content="Download update"
                Style="{DynamicResource DialogPrimaryButton}"
                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <Grid Grid.Row="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="Close"
                Grid.Column="3"
                Content="Close"
                Style="{DynamicResource DialogPrimaryButton}" />
        </Grid>
    </Grid>
</Window>
