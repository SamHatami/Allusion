<Window
    x:Class="Allusion.Views.Dialogs.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cm="http://caliburnmicro.com"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:Allusion.ViewModels.Dialogs"
    xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Settings"
    MinWidth="400"
    SizeToContent="WidthAndHeight"
    cm:Message.Attach="[Key Escape] = [Close]; [Key Enter] = [Close]"
    d:DataContext="{d:DesignInstance Type=dialogs:SettingsViewModel}"
    ResizeMode="NoResize"
    Style="{DynamicResource DialogWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />
    </WindowChrome.WindowChrome>

    <Grid Style="{DynamicResource DialogContentGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button
            x:Name="CloseButton"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            cm:Message.Attach="[Close]"
            Style="{DynamicResource TitleBarButtonClose}">
            <fa:IconImage Height="12" Icon="Close" />
        </Button>

        <Label
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            Content="{Binding Title}"
            Style="{DynamicResource DialogTitleLabel}" />

        <Label
            Grid.Row="2"
            Content="Theme"
            Style="{DynamicResource DialogLabel}" />
        <ComboBox
            Grid.Row="3"
            ItemsSource="{Binding Themes}"
            SelectedItem="{Binding SelectedTheme}"
            Style="{DynamicResource DialogComboBox}" />

        <CheckBox
            Grid.Row="4"
            Margin="0,10,0,0"
            Content="Always on top"
            IsChecked="{Binding TopMost}"
            Style="{DynamicResource DialogCheckBox}" />

        <Label
            Grid.Row="5"
            Content="Image border thickness"
            Style="{DynamicResource DialogLabel}" />
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Slider
                VerticalAlignment="Center"
                Maximum="12"
                Minimum="0"
                Value="{Binding ImageBorderThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                Grid.Column="1"
                Width="30"
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource Foreground}"
                Text="{Binding ImageBorderThickness, StringFormat={}{0:0.0}}" />
        </Grid>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="Close"
                Grid.Column="3"
                Content="Close"
                Style="{DynamicResource DialogPrimaryButton}" />
        </Grid>
    </Grid>
</Window>
