<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Allusion.Controls.GroupBox"
             x:Name="Self"
             Width="300" Height="200">
    <Border BorderBrush="{Binding BorderBrush, ElementName=Self}" BorderThickness="2" Background="#11FFFFFF">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Title on left border: use a rotated TextBlock or just left-aligned inside -->
            <Border Background="Transparent" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="2,2,0,0">
                <TextBlock Text="{Binding Title, ElementName=Self}" Foreground="{Binding BorderBrush, ElementName=Self}" FontWeight="Bold" FontSize="12"/>
            </Border>
            <ContentPresenter Grid.Row="1" Content="{Binding Content, ElementName=Self}" Margin="4"/>
        </Grid>
    </Border>
</UserControl>
